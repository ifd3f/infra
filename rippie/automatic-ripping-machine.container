[Unit]
Description=Automatic Ripping Machine

# Values translated in from scripts/docker/start_arm_container.sh
# TODO: WIP

[Container]
ContainerName=arm-rippers
Image=docker.io/automaticrippingmachine/automatic-ripping-machine:latest
PublishPort=8080:8080
Environment=ARM_UID=1000
Environment=ARM_GID=1000
Environment=TZ=America/Los_Angeles

# Volumes
Volume=/srv/arm:/home/arm
Volume=/srv/arm/music:/home/arm/music
Volume=/srv/arm/logs:/home/arm/logs
Volume=/srv/arm/media:/home/arm/media
Volume=/srv/arm/config:/etc/arm/config

# Optical drives
AddDevice=/dev/sr0:/dev/sr0
AddDevice=/dev/sr1:/dev/sr1
AddDevice=/dev/sr2:/dev/sr2
AddDevice=/dev/sr3:/dev/sr3
AddDevice=/dev/sr4:/dev/sr4
AddDevice=/dev/sr5:/dev/sr5
AddDevice=/dev/sr6:/dev/sr6
AddDevice=/dev/sr7:/dev/sr7
AddDevice=/dev/sr8:/dev/sr8

# Privileged mode
PodmanArgs=--privileged

# Ensure that one of the CPUs is left open
PodmanArgs=--cpuset-cpus=2,3,4,5,6,7

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target default.target
